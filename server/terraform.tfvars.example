# Copy to terraform.tfvars (gitignored) and fill in (README.md, "Step 2: fill in your values").

# CHANGE ME: the region you applied bootstrap/ with; the deploy role works in that region alone.
region = "us-east-1"

# CHANGE ME: bootstrap's deploy_role_arn output (terraform -chdir=bootstrap output -raw deploy_role_arn).
deploy_role_arn = "arn:aws:iam::111122223333:role/fermix-server-deploy"

# CHANGE ME: your email address(es) for the status-check alarm and the monthly budget. Leave it
# out for no topic and no budget.
# alert_emails = ["you@example.com"]

# CHANGE ME (review): the whole account's monthly budget in USD, counted before credits; the
# server alone costs about $23 a month in us-east-1 (README.md, "Cost").
# monthly_budget_usd = 30

# CHANGE ME (review): the instance type (Graviton only, the AMI is arm64) and the root volume that
# holds the Fermix home, in GB. Choose before the first apply.
# instance_type  = "t4g.small"
# root_volume_gb = 20

# CHANGE ME (review): memory and disk metrics through the CloudWatch agent, about $1 a month.
# enable_cloudwatch_agent = true

# CHANGE ME (review): daily root volume snapshots, 7 kept, starting within the hour after the time
# in UTC. On unless set to false.
# enable_ebs_snapshots  = true
# ebs_snapshot_time_utc = "03:00"

# CHANGE ME (review): Fermix's own encrypted snapshots in an S3 bucket, signed with a session of
# bootstrap's snapshot writer role (no keys anywhere). On unless set to false.
# enable_s3_backups = true

# Leave this out until you remove the server: the one switch that lets terraform destroy remove it
# (README.md, "Removing the server").
# allow_destroy = true
