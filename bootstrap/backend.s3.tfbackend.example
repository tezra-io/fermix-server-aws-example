# bootstrap's own backend, the account-specific half. Write
# bootstrap/backend.s3.tfbackend (gitignored) from bootstrap's output after its
# first apply, not by hand:
#   terraform -chdir=bootstrap output -raw bootstrap_backend > bootstrap/backend.s3.tfbackend
# The other half (key, encrypt, use_lockfile) is in bootstrap/versions.tf.

# CHANGE ME: your state bucket, fermix-server-state-<account>-<region>; bootstrap_backend writes it.
bucket = "fermix-server-state-111122223333-us-east-1"
# CHANGE ME: your region, the one bootstrap/ was applied with.
region = "us-east-1"
# CHANGE ME: the ARN of the state key (alias/fermix-server-state) bootstrap made in your account.
kms_key_id = "arn:aws:kms:us-east-1:111122223333:key/00000000-0000-0000-0000-000000000000"
